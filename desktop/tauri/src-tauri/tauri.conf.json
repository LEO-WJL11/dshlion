{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LionBox",
  "version": "1.5.3",
  "identifier": "com.lioncode.lionbox",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "publisher": "LionCode",
    "shortDescription": "LionBox 桌面版",
    "longDescription": "LionBox 桌面版：用系统自带的 WebView 套壳本地 WebUI（界面就是后端发的那一份，不做第二套）。",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false
      }
    }
  }
}
