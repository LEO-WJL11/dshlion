# NOTE: the shipped installer in installer/release/ is deliberately force-added (git add -f).
# Git cannot re-include files inside an ignored directory, so -f is required.
# Rebuild: ISCC.exe installer\LionBox.iss  (keeps the path ignored for future builds)

# Python ??
__pycache__/
*.pyc

# Electron 打包用的暂存运行时（101MB，本机从已安装的 LionBox 拷过来，不入库）
desktop/electron/staging-backend/
desktop/electron/dist/

# dist/skills/ is a build-time copy of the repo skills/ dir (artifact, never committed)
dist/skills/

# Tauri/Rust build output & deps
desktop/tauri/node_modules/
desktop/tauri/src-tauri/target/
desktop/tauri/src-tauri/gen/schemas/

extensions/vscode/*.vsix
